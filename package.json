{
  "name": "mimocode-powerpack",
  "version": "1.0.0",
  "description": "A comprehensive plugin bundle for MiMoCode — context management, memory, notifications, quota tracking, pixel art visualizer, code review, team coordination, autonomous loops, skill management, OpenCode plugin compatibility, Kimaki Discord integration, and 19 generic subagents.",
  "type": "module",
  "main": "dist/server.js",
  "exports": {
    "./server": "./dist/server.js",
    "./tui": "./dist/tui.js"
  },
  "scripts": {
    "build": "bun build src/server.ts src/tui.ts --outdir dist --target bun --external @huggingface/transformers --external bun:sqlite",
    "typecheck": "tsc --noEmit",
    "dev": "bun --watch src/server.ts"
  },
  "peerDependencies": {
    "@mimo-ai/plugin": "*"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.1.0",
    "@xberg-io/tree-sitter-language-pack": "^1.0.0",
    "better-sqlite3": "^12.11.1",
    "comment-json": "^5.0.0",
    "xdg-basedir": "^5.1.0"
  },
  "devDependencies": {
    "@clack/prompts": "^1.7.0",
    "@mimo-ai/plugin": "latest",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "latest",
    "bun-types": "^1.3.0",
    "typescript": "^5.7.0"
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "license": "MIT",
  "keywords": [
    "mimocode",
    "plugin",
    "context",
    "memory",
    "search",
    "notifications",
    "quota",
    "visualizer",
    "agents",
    "code-review",
    "team",
    "skills",
    "opencode-compat",
    "kimaki"
  ]
}
